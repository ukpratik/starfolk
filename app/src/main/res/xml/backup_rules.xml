<!-- API ≤ 30 (LLD §2.4, D-017). An include-list: only progress and settings are backed up. private.db (moods, notes,
     star names, letters, WHO-5) is never listed, so it never leaves the phone; anything new is excluded by default.
     BackupRulesTest enforces this. -->
<full-backup-content>
    <include domain="database" path="core.db" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
